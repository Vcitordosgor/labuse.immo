---
// Polices auto-hébergées (pas de CDN Google → RGPD + perf).
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
// Fichiers critiques préchargés (mêmes assets hashés que le CSS).
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import groteskUrl from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  schemas?: Record<string, unknown>[];
  home?: boolean;
}

const {
  title = 'Tout le foncier de La Réunion au même endroit | LABUSE',
  description = 'LABUSE réunit cadastre, PLU, risques, ventes et permis des 24 communes de La Réunion. Chaque information cite sa source.',
  noindex = false,
  schemas = [],
} = Astro.props;

const site = 'https://labuse.immo';
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = `${site}/og.jpg`;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'LABUSE',
  alternateName: 'LA BUSE',
  url: `${site}/`,
  logo: `${site}/apple-touch-icon.png`,
  email: 'contact@labuse.immo',
  areaServed: { '@type': 'Place', name: 'La Réunion' },
  contactPoint: { '@type': 'ContactPoint', contactType: 'sales', email: 'contact@labuse.immo', availableLanguage: 'French' },
};
const website = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'LABUSE', url: `${site}/`, inLanguage: 'fr-FR' };
const ld = [organization, website, ...schemas];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0A0C0B" />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={groteskUrl} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LABUSE" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="LABUSE — tout le foncier de La Réunion au même endroit" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
